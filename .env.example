# === Supabase (captura de leads) ===
# Obtén estos valores en: Supabase → tu proyecto → Project Settings → API
# Para el servidor va la secret key (service_role), NO la publishable/anon.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Notificación por correo (Resend) — opcional ===
# Si no se configuran, la captura sigue funcionando pero sin aviso por correo.
# RESEND_API_KEY: API key de https://resend.com (empieza con "re_")
# LEAD_NOTIFY_EMAIL: correo que recibe el aviso de cada lead
# LEAD_FROM_EMAIL: remitente verificado en Resend (opcional)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
